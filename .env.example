NEAR_ENV=testnet
# A funded testnet account (~60 NEAR for a full deploy plus demo). Keep the name short: vault ids are inv-<id>.factor.<MASTER_ACCOUNT> (max 64 chars).
MASTER_ACCOUNT=yourname.testnet
MASTER_PRIVATE_KEY=ed25519:...
# demo accounts (alice, bob, carol, council2, council3, factor, musdc) are created as
# sub-accounts of MASTER_ACCOUNT automatically and share its key.
